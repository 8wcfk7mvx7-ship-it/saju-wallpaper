{
  "name": "epub-factory-standalone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "dist:mac": "vite build && electron-builder --mac zip --x64 --arm64 --publish=never"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33",
    "electron-builder": "^25",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0"
  },
  "build": {
    "appId": "kr.ai.summerpalace.epubfactory",
    "productName": "이펍공장",
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["zip"]
    }
  }
}
